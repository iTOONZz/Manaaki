---
import EnquiryForm from './EnquiryForm.astro';
---
<section id="contact" class="py-16 md:py-24 bg-cream">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="font-serif text-3xl md:text-4xl text-ink mb-4">Get in touch</h2>
      <p class="text-ink/65 max-w-xl mx-auto text-lg">
        Enquire about care for your whānau. Get in touch early, spaces fill by due month.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <div class="space-y-8">
        <div class="space-y-4">
          <div class="flex gap-3 items-start">
            <svg class="w-5 h-5 text-sage flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <address class="not-italic text-ink/80">
              <p class="font-medium text-ink">Level 1, 15 Daly Street</p>
              <p>Hutt Central, Lower Hutt 5010</p>
            </address>
          </div>

          <div class="flex gap-3 items-start">
            <svg class="w-5 h-5 text-sage flex-shrink-0 mt-0.5" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <address class="not-italic text-ink/80">
              <p class="font-medium text-ink">4 Exchange Street</p>
              <p>Ebdentown, Upper Hutt 5018</p>
            </address>
          </div>

          <div class="flex gap-3 items-center">
            <svg class="w-5 h-5 text-sage flex-shrink-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <a href="tel:0800643993" class="text-ink font-medium hover:text-sage transition-colors">
              0800 643 993
            </a>
          </div>

        </div>

        <div class="flex gap-5">
          <a
            href="https://www.facebook.com/profile.php?id=61569933419412"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-ink/65 hover:text-sage transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage rounded"
          >
            <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
            Facebook
          </a>
          <a
            href="https://www.instagram.com/jademidwife.nz/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-sm text-ink/65 hover:text-sage transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage rounded"
          >
            <svg class="w-5 h-5" aria-hidden="true" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
            Instagram
          </a>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-sm border border-mint/60 h-64">
          <iframe
            title="Manaaki Midwives location - Level 1, 15 Daly Street, Lower Hutt"
            src="https://maps.google.com/maps?q=15+Daly+Street,+Lower+Hutt+5010+New+Zealand&output=embed&z=16"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="rounded-2xl overflow-hidden shadow-sm border border-mint/60 h-64">
          <iframe
            title="Manaaki Midwives location - 4 Exchange Street, Upper Hutt"
            src="https://maps.google.com/maps?q=4+Exchange+Street,+Upper+Hutt+5018+New+Zealand&output=embed&z=16"
            class="w-full h-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <div id="enquire" class="bg-white rounded-2xl p-6 md:p-8 shadow-sm border border-mint/50">
        <h3 class="font-serif text-2xl text-ink mb-2">Enquire about care</h3>
        <p class="text-sm text-ink/65 mb-6">Your enquiry goes to our whole midwifery team. We aim to respond within 48 hours, excluding weekends.</p>
        <EnquiryForm />
      </div>
    </div>
  </div>
</section>
