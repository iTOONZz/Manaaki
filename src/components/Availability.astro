---
import availability from '../data/availability.json';

type Status = 'available' | 'limited' | 'full';

const statusConfig: Record<Status, { label: string; bg: string; text: string }> = {
  available: { label: "Available", bg: "bg-sage", text: "text-white" },
  limited:   { label: "Limited",   bg: "bg-amber", text: "text-ink" },
  full:      { label: "Full",      bg: "bg-taupe", text: "text-white" },
};

const monthNames: Record<string, string> = {
  "01": "January", "02": "February", "03": "March", "04": "April",
  "05": "May", "06": "June", "07": "July", "08": "August",
  "09": "September", "10": "October", "11": "November", "12": "December",
};

const entries = Object.entries(availability as Record<string, string>).map(([key, status]) => {
  const [year, month] = key.split('-');
  return { key, year, month, name: monthNames[month], status: status as Status };
});
---
<section id="availability" class="py-16 md:py-24 bg-mint/20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <h2 class="font-serif text-3xl md:text-4xl text-ink mb-4">Availability</h2>
      <p class="text-ink/65 max-w-xl mx-auto">
        Current availability by estimated due month.
      </p>
    </div>

    <div
      class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-3 mb-8"
      role="list"
      aria-label="Availability by month"
    >
      {entries.map(entry => {
        const config = statusConfig[entry.status];
        return (
          <div
            role="listitem"
            class={`${config.bg} ${config.text} rounded-xl p-3 text-center shadow-sm`}
          >
            <div class="text-xs font-medium opacity-75 mb-0.5">{entry.year}</div>
            <div class="font-serif font-semibold text-sm">{entry.name}</div>
            <div class="text-xs mt-1 opacity-85">{config.label}</div>
          </div>
        );
      })}
    </div>

    <div class="flex flex-wrap justify-center gap-6 text-sm mb-6" role="list" aria-label="Availability key">
      <div class="flex items-center gap-2" role="listitem">
        <div class="w-3 h-3 rounded-full bg-sage" aria-hidden="true"></div>
        <span class="text-ink/65">Available</span>
      </div>
      <div class="flex items-center gap-2" role="listitem">
        <div class="w-3 h-3 rounded-full bg-amber" aria-hidden="true"></div>
        <span class="text-ink/65">Limited spaces</span>
      </div>
      <div class="flex items-center gap-2" role="listitem">
        <div class="w-3 h-3 rounded-full bg-taupe" aria-hidden="true"></div>
        <span class="text-ink/65">Full</span>
      </div>
    </div>

    <p class="text-center">
      <a href="#contact" class="text-sage font-medium hover:text-sage-deep transition-colors underline underline-offset-2">
        Not sure? Enquire anyway →
      </a>
    </p>
  </div>
</section>
