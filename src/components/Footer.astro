---
---
<footer class="bg-ink text-cream py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid md:grid-cols-3 gap-8 mb-8">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <img
            src="/images/logo.jpg"
            alt=""
            role="presentation"
            class="h-10 w-10 object-contain rounded-full bg-white"
            width="40"
            height="40"
          />
          <div>
            <p class="font-serif font-semibold text-white text-lg leading-tight">Manaaki</p>
            <p class="text-xs tracking-widest uppercase text-cream/60">Midwives</p>
          </div>
        </div>
        <p class="text-sm leading-relaxed text-cream/70">
          Whānau-centred midwifery care across the Hutt Valley.
        </p>
      </div>

      <div>
        <h3 class="font-serif text-white font-semibold mb-4">Contact</h3>
        <address class="not-italic space-y-2 text-sm text-cream/70">
          <p>Level 1, 15 Daly Street</p>
          <p>Hutt Central, Lower Hutt 5010</p>
          <p>
            <a href="tel:0800643993" class="hover:text-cream transition-colors">0800 643 993</a>
          </p>
        </address>
      </div>

      <div>
        <h3 class="font-serif text-white font-semibold mb-4">Quick links</h3>
        <ul class="space-y-2 text-sm text-cream/70">
          <li><a href="/#about" class="hover:text-cream transition-colors">About us</a></li>
          <li><a href="/#midwives" class="hover:text-cream transition-colors">Our midwives</a></li>
          <li><a href="/#availability" class="hover:text-cream transition-colors">Availability</a></li>
          <li><a href="/#contact" class="hover:text-cream transition-colors">Enquire about care</a></li>
          <li><a href="/privacy" class="hover:text-cream transition-colors">Privacy statement</a></li>
        </ul>
      </div>
    </div>

    <div class="border-t border-cream/10 pt-6 flex flex-wrap justify-between items-center gap-4 text-xs text-cream/50">
      <p>© {new Date().getFullYear()} Manaaki Midwives. All rights reserved.</p>
      <div class="flex gap-5">
        <a
          href="https://www.facebook.com/profile.php?id=61569933419412"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-cream transition-colors"
        >
          Facebook
        </a>
        <a
          href="https://www.instagram.com/jademidwife.nz/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-cream transition-colors"
        >
          Instagram
        </a>
      </div>
    </div>
  </div>
</footer>
