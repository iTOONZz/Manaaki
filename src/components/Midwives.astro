---
import midwives from '../data/midwives.json';
---
<section id="midwives" class="pt-8 md:pt-12 pb-16 md:pb-24 bg-mint/25">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-10">
      <h2 class="font-serif text-3xl md:text-4xl text-ink mb-4">Meet the midwives</h2>
      <p class="text-ink/65 max-w-xl mx-auto text-lg mb-5">
        Our small, close-knit team brings depth of experience and genuine warmth to every whānau they care for.
      </p>
      <p class="inline-flex items-start sm:items-center gap-2 text-sm text-ink/75 bg-white/70 border border-mint px-4 py-2 rounded-2xl sm:rounded-full text-left">
        <svg class="w-4 h-4 text-sage flex-shrink-0 mt-0.5 sm:mt-0" aria-hidden="true" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span><strong class="text-ink">Clinic days:</strong> Tuesdays and Wednesdays across both our Upper Hutt and Lower Hutt clinic spaces.</span>
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-6">
      {midwives.map(midwife => (
        <div class="bg-[#F9F5EE] rounded-2xl overflow-hidden shadow-sm border border-taupe/20 flex flex-col w-full sm:w-[calc(50%-12px)]">
          <div class="relative pt-8 pb-4 px-6 text-center">
            <div class="absolute top-3 left-3 w-12 h-12 bg-taupe/25 rounded-full pointer-events-none" aria-hidden="true"></div>
            <div class="absolute bottom-2 right-3 w-8 h-8 bg-taupe/15 rounded-full pointer-events-none" aria-hidden="true"></div>

            <div class="relative mx-auto w-28 h-28 rounded-full overflow-hidden border-4 border-white shadow-md">
              <img
                src={midwife.photo}
                alt={`Portrait of ${midwife.name}`}
                class="w-full h-full object-cover"
                style={`object-position: ${midwife.photoPosition ?? 'center 22%'}`}
                width="112"
                height="112"
              />
            </div>
          </div>

          <div class="px-5 pb-6 flex-1 flex flex-col text-center">
            <div class="relative mb-2">
              <div class="absolute inset-0 -mx-2 bg-taupe/20 rounded-full" aria-hidden="true"></div>
              <h3 class="relative font-serif text-lg font-semibold text-ink py-1 px-2">{midwife.name}</h3>
            </div>
            {midwife.role && <p class="text-xs tracking-widest text-ink/55 uppercase mb-3">{midwife.role}</p>}
            {midwife.badge && (
              <p class="text-xs font-medium mb-1">
                <span class="bg-amber/30 text-ink border border-amber/50 px-2.5 py-0.5 rounded-full">{midwife.badge}</span>
              </p>
            )}
            <p class="text-sm text-ink/65 leading-relaxed mt-3 flex-1">{midwife.bio}</p>
          </div>
        </div>
      ))}

      <!-- Postnatal midwife: position not yet filled -->
      <div class="bg-[#F9F5EE] rounded-2xl overflow-hidden shadow-sm border-2 border-dashed border-taupe/35 flex flex-col w-full sm:w-[calc(50%-12px)]">
        <div class="relative pt-8 pb-4 px-6 text-center">
          <div class="absolute top-3 left-3 w-12 h-12 bg-taupe/25 rounded-full pointer-events-none" aria-hidden="true"></div>
          <div class="absolute bottom-2 right-3 w-8 h-8 bg-taupe/15 rounded-full pointer-events-none" aria-hidden="true"></div>

          <div class="relative mx-auto w-28 h-28 rounded-full overflow-hidden border-4 border-white shadow-md bg-mint flex items-center justify-center" aria-hidden="true">
            <svg class="w-14 h-14 text-sage-deep" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M9 12h.01" />
              <path d="M15 12h.01" />
              <path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5" />
              <path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1" />
            </svg>
          </div>
        </div>

        <div class="px-5 pb-6 flex-1 flex flex-col text-center">
          <div class="relative mb-2">
            <div class="absolute inset-0 -mx-2 bg-taupe/20 rounded-full" aria-hidden="true"></div>
            <h3 class="relative font-serif text-lg font-semibold text-ink py-1 px-2">Postnatal Midwife</h3>
          </div>
          <p class="text-xs font-medium mb-1 mt-1">
            <span class="bg-amber/30 text-ink border border-amber/50 px-2.5 py-0.5 rounded-full">Postnatal midwife to be confirmed</span>
          </p>
          <p class="text-sm text-ink/65 leading-relaxed mt-3 flex-1">
            Our dedicated postnatal midwife will provide ongoing support for you and your pēpi following your
            initial postnatal care with the Manaaki Midwives team.
          </p>
        </div>
      </div>
    </div>
    <div class="text-center mt-10">
      <a
        href="#enquire"
        class="inline-block px-8 py-3 bg-sage text-white font-medium rounded-full hover:bg-sage-deep transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage focus-visible:ring-offset-2"
      >
        Enquire about care
      </a>
    </div>
  </div>
</section>
