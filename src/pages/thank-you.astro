---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Enquiry received - Manaaki Midwives"
  description="Thank you for your enquiry. We'll be in touch soon."
>
  <Header />
  <main id="main-content" class="py-24 md:py-32 bg-cream min-h-[60vh]">
    <div class="max-w-xl mx-auto px-4 sm:px-6 text-center">
      <div class="w-16 h-16 rounded-full bg-mint flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-sage" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h1 class="font-serif text-3xl md:text-4xl text-ink mb-4">Enquiry received</h1>
      <p class="text-ink/70 text-lg leading-relaxed mb-8">
        Thank you for getting in touch. We'll review your enquiry and get back to you within 48 hours.
      </p>
      <a href="/" class="inline-block px-6 py-3 bg-sage text-white font-medium rounded-full hover:bg-sage-deep transition-colors">
        Back to home
      </a>
    </div>
  </main>
  <Footer />
</BaseLayout>
