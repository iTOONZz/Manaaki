---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout
  title="Privacy Statement - Manaaki Midwives"
  description="Privacy statement for Manaaki Midwives, how we collect, use and protect your information."
>
  <Header />
  <main id="main-content" class="py-16 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <h1 class="font-serif text-4xl text-ink mb-2">Privacy Statement</h1>
      <p class="text-ink/50 mb-10 text-sm">Last updated: June 2026</p>

      <div class="space-y-10">

        <section aria-labelledby="who-we-are">
          <h2 id="who-we-are" class="font-serif text-2xl text-ink mb-3">Who we are</h2>
          <p class="text-ink/75 leading-relaxed">
            Manaaki Midwives is a group of Lead Maternity Carer (LMC) midwives based at Level 1,
            15 Daly Street, Hutt Central, Lower Hutt 5010. This privacy statement applies to
            personal information collected through this website and our enquiry form.
          </p>
        </section>

        <section aria-labelledby="what-we-collect">
          <h2 id="what-we-collect" class="font-serif text-2xl text-ink mb-3">What information we collect</h2>
          <p class="text-ink/75 leading-relaxed mb-4">
            When you submit an enquiry through this website, we collect:
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-ink/75">
            <li>Your full name</li>
            <li>Email address</li>
            <li>Phone number (if provided)</li>
            <li>Estimated due date or month</li>
            <li>Suburb or area</li>
            <li>Preferred birth setting</li>
            <li>How you heard about us (if provided)</li>
            <li>Any message or additional information you choose to share</li>
          </ul>
          <p class="text-ink/75 leading-relaxed mt-4">
            We collect only the minimum information needed to respond to your enquiry.
            Detailed clinical and pregnancy information is collected securely after first
            contact, not through this public form.
          </p>
        </section>

        <section aria-labelledby="why-collect">
          <h2 id="why-collect" class="font-serif text-2xl text-ink mb-3">Why we collect it</h2>
          <p class="text-ink/75 leading-relaxed">
            We collect this information solely to respond to your enquiry about midwifery care,
            confirm availability for your due month, and determine whether we can support you
            within our catchment area.
          </p>
        </section>

        <section aria-labelledby="who-sees">
          <h2 id="who-sees" class="font-serif text-2xl text-ink mb-3">Who can see your information</h2>
          <p class="text-ink/75 leading-relaxed mb-4">
            Enquiry submissions are received by Manaaki Midwives via Netlify Forms and forwarded
            to our team inbox. Only the midwives at Manaaki Midwives access your enquiry
            information. We do not sell, share, or disclose your personal information to third
            parties, except where required by law.
          </p>
          <p class="text-ink/75 leading-relaxed">
            Netlify Forms processes form submissions on our behalf. For more information, see{" "}
            <a
              href="https://www.netlify.com/privacy/"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sage hover:text-sage-deep underline underline-offset-2"
            >
              netlify.com/privacy
            </a>.
          </p>
        </section>

        <section aria-labelledby="how-stored">
          <h2 id="how-stored" class="font-serif text-2xl text-ink mb-3">How we store your information</h2>
          <p class="text-ink/75 leading-relaxed">
            Enquiry data is stored securely by Netlify and in our team's email system. We retain
            enquiry information for as long as is reasonably necessary to respond to you and manage
            your care, in accordance with the Health Information Privacy Code 2020 and Privacy Act
            2020.
          </p>
        </section>

        <section aria-labelledby="your-rights">
          <h2 id="your-rights" class="font-serif text-2xl text-ink mb-3">Your rights</h2>
          <p class="text-ink/75 leading-relaxed mb-4">
            Under the Privacy Act 2020 and Health Information Privacy Code 2020, you have the
            right to:
          </p>
          <ul class="list-disc pl-6 space-y-1.5 text-ink/75">
            <li>Request access to personal information we hold about you</li>
            <li>Request correction of that information if it is inaccurate</li>
            <li>Ask us to stop using your information</li>
          </ul>
          <p class="text-ink/75 leading-relaxed mt-4">
            To exercise these rights, please contact us by phone at{" "}
            <a href="tel:0800643993" class="text-sage hover:text-sage-deep">0800 643 993</a> or
            in writing at Level 1, 15 Daly Street, Hutt Central, Lower Hutt 5010.
          </p>
        </section>

        <section aria-labelledby="complaints">
          <h2 id="complaints" class="font-serif text-2xl text-ink mb-3">Questions or complaints</h2>
          <p class="text-ink/75 leading-relaxed">
            If you have questions about how we handle your personal information, or wish to make a
            complaint, please contact us directly. You also have the right to make a complaint to
            the Office of the Privacy Commissioner at{" "}
            <a
              href="https://www.privacy.org.nz"
              target="_blank"
              rel="noopener noreferrer"
              class="text-sage hover:text-sage-deep underline underline-offset-2"
            >
              privacy.org.nz
            </a>.
          </p>
        </section>

        <section aria-labelledby="changes">
          <h2 id="changes" class="font-serif text-2xl text-ink mb-3">Changes to this statement</h2>
          <p class="text-ink/75 leading-relaxed">
            We may update this privacy statement from time to time. Any changes will be posted on
            this page with an updated date.
          </p>
        </section>

      </div>

      <div class="mt-12 pt-8 border-t border-mint">
        <a href="/" class="text-sage font-medium hover:text-sage-deep transition-colors">
          ← Back to Manaaki Midwives
        </a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
